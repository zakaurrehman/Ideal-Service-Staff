{
  "name": "idealservicestaff-web",
  "version": "1.0.0",
  "private": true,
  "description": "Ideal Service Staff — public website and healthcare staffing platform (Next.js + PostgreSQL).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/optimize-assets.mjs",
    "content:sync": "node scripts/sync-wordpress-content.mjs",
    "vercel-build": "tsx scripts/db-migrate.mts && next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.mts",
    "db:studio": "drizzle-kit studio",
    "admin:create": "tsx scripts/admin-create.mts",
    "test": "tsx --test tests/*.test.mts",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@node-rs/argon2": "^2.2.2",
    "@vercel/blob": "^2.9.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.14.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.75.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "playwright-core": "^1.65.1",
    "postcss": "^8.5.33",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    }
  }
}
