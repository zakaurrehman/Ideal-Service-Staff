# Copy to .env.local for local development. Never commit real values.
# Full reference: docs/ENVIRONMENT-VARIABLES.md

# ─── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://idealservicestaff.com

# ─── Platform database (PostgreSQL / Neon) ─────────────────────────────────
# Added automatically by the Vercel ↔ Neon integration. Leave empty locally to
# use the embedded development database in .data/ (PGlite).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ─── Email (Resend) ────────────────────────────────────────────────────────
# Without a key, emails are logged (Admin → Notifications) but not sent.
RESEND_API_KEY=
EMAIL_FROM="Ideal Service Staff <no-reply@idealservicestaff.com>"

# ─── Private file storage (Vercel Blob) ────────────────────────────────────
# Added automatically when a Blob store is connected. Locally, files go to .data/uploads.
BLOB_READ_WRITE_TOKEN=

# ─── Cron (daily email retry + session clean-up) ───────────────────────────
CRON_SECRET=

# ─── Optional ──────────────────────────────────────────────────────────────
# Blog posts are still read from WordPress (bundled snapshot as fallback).
WORDPRESS_URL=https://idealservicestaff.com
# Extra copy of website form submissions (the database is the system of record).
INQUIRY_TO_EMAIL=Info@idealservicestaff.com
INQUIRY_FROM_EMAIL="Ideal Service Staff Website <website@idealservicestaff.com>"
FORMS_WEBHOOK_URL=
FORMS_WEBHOOK_SECRET=
