# ─── Public site ────────────────────────────────────────────────────────────
# Canonical origin of the new front-end (used for canonical URLs, sitemap, OG).
NEXT_PUBLIC_SITE_URL=https://idealservicestaff.com

# ─── Existing WordPress back-end ───────────────────────────────────────────
# Source of blog posts (REST API). Blog pages revalidate against it hourly.
WORDPRESS_URL=https://idealservicestaff.com

# Origin that serves the WordPress account system (User Registration plugin:
# /sign-in/, /registration/, /lost-password/, /my-account/) and the Amelia
# customer / employee panels. When the new front-end takes over the main
# domain, move WordPress to a subdomain (e.g. https://portal.idealservicestaff.com)
# and set it here. Must be a DIFFERENT origin from NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_PORTAL_URL=https://idealservicestaff.com

# Optional: full URL of a working online booking page (e.g. the Amelia
# step-booking page once the plugin is re-activated). Leave empty to show the
# booking-request form only.
NEXT_PUBLIC_BOOKING_URL=

# ─── Form delivery (care requests, job applications, contact, booking) ─────
# At least one channel must be configured in production, otherwise the API
# answers 503 and the forms tell visitors to call instead (never a fake success).

# Option A — email via Resend (https://resend.com). Verify the sender domain first.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=Info@idealservicestaff.com
INQUIRY_FROM_EMAIL="Ideal Service Staff Website <website@idealservicestaff.com>"

# Option B — JSON webhook (Zapier, Make, n8n, a CRM, or a WordPress endpoint).
FORMS_WEBHOOK_URL=
# Sent as the X-Webhook-Secret header so the receiver can verify the source.
FORMS_WEBHOOK_SECRET=
